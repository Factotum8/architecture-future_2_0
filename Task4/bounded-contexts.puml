@startuml bounded-contexts-future-2-0
'!theme plain
title «Будущее 2.0» — bounded contexts (целевая модель, DDD)

skinparam packageStyle rectangle
'skinparam linetype ortho

package "Клинические операции" as CO  {
  [Управление пациентским потоком, расписание, визиты]
}

package "Клиническая запись" as CR  {
  [Медкарта, эпикризы, назначения (в рамках регуляторики)]
}

package "Диагностика и ИИ" as AI {
  [Инференс ИИ, оркестрация исследований, результаты]
}

package "Финтех" as FT {
  [Счета, кредиты, платежи, лимиты]
}

package "Биллинг и договоры" as BC  {
  [Счета на оплату, договоры с пациентом/страховкой]
}

package "Склад и оборудование" as SE  {
  [Инвентаризация, расходники, медустройства]
}

package "Платформа данных и витрины" as DP {
  [Озеро, витрины, каталог, портал самообслуживания без сырой PHI]
}

package "Идентичность и доступ" as IAM {
  [Единый вход, RBAC/ABAC]
}

package "Интеграция (переходный период)" as LEG {
  [Camel, адаптеры к DWH, антикоррупционные слои]
}

CO --> CR : определяет границы визита / эпизода
CO --> AI : заказывает исследование
CR --> AI : передаёт контекст (минимально необходимый)
AI --> CR : фиксирует результат (в клинической записи)
CO --> BC : инициирует выставление счёта
BC --> FT : оплата /кредитный продукт
FT --> BC : статус платежа /договора
CO --> SE : списание /заказ расходников
DP --> CO : агрегированные события / метрики\n(обезличенные)
DP --> FT : финансовые витрины
IAM .. CO : политики доступа
LEG -> CO : синхронизация легаси (временно)
LEG -> DP : CDC / батчи из DWH (временно)

@enduml
